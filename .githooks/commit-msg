#!/bin/sh
# Validates the commit subject line. See docs/ai/commit-convention.md.

subject=$(head -n 1 "$1")
pattern='^(feat|chore|fix|docs): [^ ].*\.$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "ERROR: invalid commit message: \"$subject\"" >&2
  echo "Expected: <feat|chore|fix|docs>: <description>." >&2
  echo "Example:  feat: add new feature." >&2
  echo "See docs/ai/commit-convention.md" >&2
  exit 1
fi
